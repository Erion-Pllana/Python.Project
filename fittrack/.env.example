# =========================================================
# FitTrack environment configuration
# Copy this file to ".env" and fill in real values.
# =========================================================

# ---- Application ----
APP_NAME=FitTrack
APP_ENV=development
DEBUG=True

# ---- FastAPI backend ----
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# ---- Streamlit frontend ----
# Base URL the Streamlit app uses to reach the FastAPI backend
API_BASE_URL=http://127.0.0.1:8000

# ---- MySQL database ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=fittrack_user
DB_PASSWORD=change_me
DB_NAME=fittrack

# ---- Security (used from Step 2 onward: authentication) ----
SECRET_KEY=change_this_to_a_long_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
